#!/bin/bash
# ==============================================================================
# UbRoid - Virtual Keyboard Toggle (Onboard & Android Gboard)
# Repository: https://github.com/triwahyu45/UbRoid_TriWahyu45
# Author: Tri Wahyu Handoyo (triwahyu45)
# ==============================================================================

unset LD_PRELOAD
export DISPLAY=:0

PREF_FILE="/etc/ubroid/keyboard_pref"
KEYBOARD_PREF="smart"
[ -f "$PREF_FILE" ] && KEYBOARD_PREF=$(cat "$PREF_FILE" 2>/dev/null | tr -d '[:space:]')

toggle_onboard() {
    if command -v onboard >/dev/null 2>&1; then
        if pgrep -x onboard >/dev/null; then
            dbus-send --type=method_call --dest=org.onboard.Onboard /org/onboard/Onboard/Keyboard org.onboard.Onboard.Keyboard.ToggleVisible 2>/dev/null || {
                killall onboard 2>/dev/null
            }
        else
            nohup onboard >/dev/null 2>&1 &
        fi
        return 0
    fi
    return 1
}

toggle_gboard() {
    # 1. Pemicu Termux-X11 native soft keyboard via broadcast
    /system/bin/am broadcast --user 0 -a com.termux.x11.ACTION_CUSTOM -p com.termux.x11 \
      --es what "swipeUp" >/dev/null 2>&1 || true

    # 2. Pemicu fallback via adb jika tersedia
    if command -v adb >/dev/null 2>&1; then
        adb shell input keyevent 111 >/dev/null 2>&1 || true
    fi
}

case "$KEYBOARD_PREF" in
    "gboard")
        toggle_gboard
        ;;
    "onboard")
        toggle_onboard
        ;;
    *)
        # Mode Smart: Coba Onboard terlebih dahulu, jika gagal atau tidak terpasang fallback ke Gboard
        if ! toggle_onboard; then
            toggle_gboard
        fi
        ;;
esac

exit 0
