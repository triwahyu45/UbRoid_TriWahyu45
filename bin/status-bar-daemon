#!/usr/bin/env python3
import time
import subprocess
import os

def get_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, timeout=1.2).decode().strip()
    except Exception:
        return ""

def update_file_if_changed(filepath, new_content):
    try:
        with open(filepath, "r") as f:
            old = f.read()
    except Exception:
        old = ""
    if old != new_content:
        tmp = filepath + ".tmp"
        with open(tmp, "w") as f:
            f.write(new_content)
        os.replace(tmp, filepath)
        return True
    return False

def make_battery_svg(level, charging):
    fill_w = max(1, int(15 * (level / 100.0)))
    fill_color = "#35b9e8" if charging else ("#4be060" if level > 20 else "#e95420")
    bolt = '<path d="M 11 0.5 L 7.5 5.5 L 10.5 5.5 L 9 10.5 L 14.5 5 L 11.5 5 Z" fill="#ffeb3b" stroke="#000000" stroke-width="0.7" />' if charging else ''

    svg = f'''<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
  <rect x="2" y="1.5" width="18" height="9.5" rx="2" fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.9" />
  <path d="M 20.5 4.5 Q 21.5 4.5 21.5 5.3 L 21.5 7.3 Q 21.5 8 20.5 8 Z" fill="#ffffff" opacity="0.9" />
  <rect x="3.5" y="3" width="{fill_w}" height="6.5" rx="1" fill="{fill_color}" />
  {bolt}
  <text x="12" y="22" font-family="Ubuntu, sans-serif" font-size="10" font-weight="900" fill="#000000" stroke="#000000" stroke-width="1.8" text-anchor="middle">{level}%</text>
  <text x="12" y="22" font-family="Ubuntu, sans-serif" font-size="10" font-weight="900" fill="#ffffff" text-anchor="middle">{level}%</text>
</svg>'''
    return svg

def update_status():
    home = os.path.expanduser("~")

    # Single combined lightweight check (Battery + Wi-Fi) with 1s timeout
    combined_raw = get_cmd("adb -s 127.0.0.1:5555 shell 'dumpsys battery 2>/dev/null; cmd wifi status 2>/dev/null'")
    
    level = 94
    charging = False
    temp_c = "33°C"
    volt_v = "4.2V"
    ssid = "Wi-Fi Aktif"

    for line in combined_raw.splitlines():
        line = line.strip()
        if line.startswith("level:"):
            try:
                level = int(line.split(":")[1].strip())
            except Exception:
                pass
        elif line.startswith("status:"):
            charging = (line.split(":")[1].strip() in ["2", "5"])
        elif line.startswith("temperature:"):
            try:
                temp_c = f"{int(line.split(':')[1].strip()) / 10:.1f}°C"
            except Exception:
                pass
        elif line.startswith("voltage:"):
            try:
                volt_v = f"{int(line.split(':')[1].strip()) / 1000:.2f}V"
            except Exception:
                pass
        elif "SSID:" in line:
            parts = line.split("SSID:")
            if len(parts) > 1:
                ssid = parts[1].strip().strip('"')

    bolt = "⚡ " if charging else ""
    status_label = "Mengisi Daya" if charging else "Baterai"

    # Write live battery SVGs atomically
    svg_code = make_battery_svg(level, charging)
    update_file_if_changed("/tmp/battery_icon.svg", svg_code)
    update_file_if_changed("/tmp/battery_live.svg", svg_code)
    update_file_if_changed("/tmp/battery_pct.txt", f"{level}%")

    bat_desktop = f"{home}/.config/xfce4/panel/launcher-40/battery.desktop"
    bat_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name=Status Baterai
Comment={bolt}Baterai: {level}% ({status_label}) | Suhu: {temp_c} | Voltase: {volt_v}
Exec=/usr/local/bin/dialog-battery
Icon=/tmp/battery_live.svg
Terminal=false
StartupNotify=false
Categories=Utility;
"""
    update_file_if_changed(bat_desktop, bat_content)

    # Update Wi-Fi launcher
    wifi_desktop = f"{home}/.config/xfce4/panel/launcher-41/wifi.desktop"
    wifi_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name=Status Wi-Fi
Comment=Wi-Fi: {ssid}
Exec=/usr/local/bin/dialog-wifi
Icon=network-wireless-signal-excellent-symbolic
Terminal=false
StartupNotify=false
Categories=Network;
"""
    update_file_if_changed(wifi_desktop, wifi_content)

    # Static Bluetooth (lightweight, no continuous dumpsys polling)
    bt_desktop = f"{home}/.config/xfce4/panel/launcher-42/bluetooth.desktop"
    bt_content = """[Desktop Entry]
Version=1.0
Type=Application
Name=Status Bluetooth
Comment=Bluetooth
Exec=/usr/local/bin/dialog-bluetooth
Icon=bluetooth-active-symbolic
Terminal=false
StartupNotify=false
Categories=HardwareSettings;
"""
    update_file_if_changed(bt_desktop, bt_content)

if __name__ == "__main__":
    while True:
        try:
            update_status()
        except Exception:
            pass
        time.sleep(30)
