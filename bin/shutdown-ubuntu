#!/bin/bash
# Matikan sesi XFCE secara bersih dan kembalikan Android ke mode normal
echo "Mematikan Desktop Ubuntu & Mengembalikan RAM ke Android..."
/usr/local/bin/linux-os-mode exit >/dev/null 2>&1 || true
xfce4-session-logout --logout --fast 2>/dev/null || true
sleep 0.5
pkill -9 -f xfce4-session 2>/dev/null || true
pkill -9 -f xfce4-panel 2>/dev/null || true
pkill -9 -f xfwm4 2>/dev/null || true
pkill -9 -f xfsettingsd 2>/dev/null || true
