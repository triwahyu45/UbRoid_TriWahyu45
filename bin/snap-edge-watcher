#!/usr/bin/env python3
"""
Zero-Subprocess X11 Window Edge-Drag Watcher using pure in-memory GdkX11.
Supports 3-tier vertical edge snapping (Left/Right Top, Middle, Bottom).
No display.sync() blocking to maintain 120Hz smooth dragging.
"""
import os
import subprocess
import time

os.environ.setdefault("DISPLAY", ":0")

import gi
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib


class EdgeWatcher:
    def __init__(self):
        self.display = Gdk.Display.get_default()
        self.screen = Gdk.Screen.get_default()
        self.last_xid = None
        self.last_geo = None
        self.dragging = False
        self.last_move_time = 0.0
        self.cooldown_until = 0.0

    def get_pointer_xy(self):
        try:
            seat = self.display.get_default_seat()
            ptr = seat.get_pointer()
            _, x, y = ptr.get_position()
            return int(x), int(y)
        except Exception:
            return -1, -1

    def tick(self):
        now = time.time()
        if now < self.cooldown_until:
            return True

        try:
            win = self.screen.get_active_window()
            if not win:
                self.dragging = False
                self.last_xid = None
                self.last_geo = None
                return True

            hint = win.get_type_hint()
            if hint in (
                Gdk.WindowTypeHint.DOCK,
                Gdk.WindowTypeHint.DESKTOP,
                Gdk.WindowTypeHint.POPUP_MENU,
                Gdk.WindowTypeHint.UTILITY,
            ):
                return True

            xid = win.get_xid()
            _, wx, wy = win.get_origin()
            ww = win.get_width()
            wh = win.get_height()
            geo = (wx, wy, ww, wh)

            if xid == self.last_xid and self.last_geo is not None:
                dx = abs(geo[0] - self.last_geo[0])
                dy = abs(geo[1] - self.last_geo[1])
                dw = abs(geo[2] - self.last_geo[2])
                dh = abs(geo[3] - self.last_geo[3])

                if (dx > 3 or dy > 3) and dw < 6 and dh < 6:
                    self.dragging = True
                    self.last_move_time = now
                elif self.dragging and (now - self.last_move_time) >= 0.22:
                    self.dragging = False
                    px, py = self.get_pointer_xy()
                    sw = self.screen.get_width() if self.screen else 808
                    sh = self.screen.get_height() if self.screen else 1725

                    # Vertical 3-tier boundary heights
                    tier1 = sh // 3
                    tier2 = (sh * 2) // 3

                    # Reference Y coordinate for vertical positioning
                    ref_y = py if py > 0 else (wy + 20)

                    # Top edge drag
                    if (py <= 54 or wy <= 48) and ww < (sw - 20):
                        if px > 0 and (sw * 0.30) <= px <= (sw * 0.70):
                            subprocess.Popen(["/usr/local/bin/snap-layout", "maximize"])
                        else:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "top-half"])
                        self.cooldown_until = now + 1.4

                    # Bottom edge drag
                    elif (py >= (sh - 110) or (wy + wh) >= (sh - 70)) and ww < (sw - 20):
                        subprocess.Popen(["/usr/local/bin/snap-layout", "bottom-half"])
                        self.cooldown_until = now + 1.4

                    # Right edge drag -> 3 Vertically Stacked Windows
                    elif (px >= (sw - 45) or (wx + ww) >= (sw - 25)) and 50 <= ref_y <= (sh - 70) and ww < (sw - 20):
                        if ref_y < tier1:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "right-top"])
                        elif ref_y < tier2:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "right-middle"])
                        else:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "right-bottom"])
                        self.cooldown_until = now + 1.4

                    # Left edge drag -> 3 Vertically Stacked Windows
                    elif (px <= 45 or wx <= 25) and 50 <= ref_y <= (sh - 70) and ww < (sw - 20):
                        if ref_y < tier1:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "left-top"])
                        elif ref_y < tier2:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "left-middle"])
                        else:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "left-bottom"])
                        self.cooldown_until = now + 1.4

            self.last_xid = xid
            self.last_geo = geo
        except Exception:
            pass
        return True


def main():
    watcher = EdgeWatcher()
    GLib.timeout_add(180, watcher.tick)
    loop = GLib.MainLoop()
    loop.run()


if __name__ == "__main__":
    main()
