#!/usr/bin/env python3
"""
UbRoid Auto-Snap Edge Watcher
Triggers instant snapping when any window is dragged/moved to the screen edges.
Features:
- Pure in-memory GDK query (no slow child processes while moving)
- Works seamlessly on Android touch screens and physical mouse
- Supports 3-tier vertical snapping on Left and Right borders
- Top edge maximize / snap
- Bottom edge snap
- Protected by Gdk error trap against BadWindow
"""

import os
import sys
import time
import subprocess

os.environ.setdefault("DISPLAY", ":0")

import gi
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib


class SnapEdgeWatcher:
    def __init__(self):
        self.screen = Gdk.Screen.get_default()
        self.last_xid = None
        self.last_pos = None
        self.moving = False
        self.last_move_time = 0.0
        self.cooldown_until = 0.0

    def tick(self):
        now = time.time()
        if now < self.cooldown_until:
            return True

        if not self.screen:
            return True

        Gdk.error_trap_push()
        try:
            win = self.screen.get_active_window()
            if not win:
                self.moving = False
                self.last_xid = None
                self.last_pos = None
                return True

            hint = win.get_type_hint()
            if hint in (
                Gdk.WindowTypeHint.DOCK,
                Gdk.WindowTypeHint.DESKTOP,
                Gdk.WindowTypeHint.POPUP_MENU,
                Gdk.WindowTypeHint.UTILITY,
            ):
                return True

            xid = win.get_xid()
            _, wx, wy = win.get_origin()
            ww = win.get_width()
            wh = win.get_height()

            sw = self.screen.get_width() if self.screen else 808
            sh = self.screen.get_height() if self.screen else 1725

            # Ignore already maximized / full-screen windows
            if ww >= (sw - 16) and wh >= (sh - 140):
                self.moving = False
                self.last_xid = xid
                self.last_pos = (wx, wy)
                return True

            cur_pos = (wx, wy)
            if xid == self.last_xid and self.last_pos is not None:
                dx = abs(cur_pos[0] - self.last_pos[0])
                dy = abs(cur_pos[1] - self.last_pos[1])

                if dx > 3 or dy > 3:
                    # Window is in motion!
                    self.moving = True
                    self.last_move_time = now
                elif self.moving and (now - self.last_move_time) >= 0.12:
                    # Window was moving, and has now STOPPED / DROPPED!
                    self.moving = False

                    tier1 = sh // 3
                    tier2 = (sh * 2) // 3
                    ref_y = wy + 20

                    # 1. Top Edge Drag (wy near top)
                    if wy <= 54:
                        if (sw * 0.25) <= wx <= (sw * 0.75):
                            subprocess.Popen(["/usr/local/bin/snap-layout", "maximize"])
                        else:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "top-half"])
                        self.cooldown_until = now + 1.2

                    # 2. Bottom Edge Drag (bottom edge near dock)
                    elif (wy + wh) >= (sh - 95):
                        subprocess.Popen(["/usr/local/bin/snap-layout", "bottom-half"])
                        self.cooldown_until = now + 1.2

                    # 3. Right Edge Drag
                    elif (wx + ww) >= (sw - 35):
                        if ref_y < tier1:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "right-top"])
                        elif ref_y < tier2:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "right-middle"])
                        else:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "right-bottom"])
                        self.cooldown_until = now + 1.2

                    # 4. Left Edge Drag
                    elif wx <= 35:
                        if ref_y < tier1:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "left-top"])
                        elif ref_y < tier2:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "left-middle"])
                        else:
                            subprocess.Popen(["/usr/local/bin/snap-layout", "left-bottom"])
                        self.cooldown_until = now + 1.2

            self.last_xid = xid
            self.last_pos = cur_pos
        except Exception:
            pass
        finally:
            Gdk.error_trap_pop_ignored()

        return True


def main():
    watcher = SnapEdgeWatcher()
    GLib.timeout_add(60, watcher.tick)
    loop = GLib.MainLoop()
    loop.run()


if __name__ == "__main__":
    main()
