#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk
import subprocess
import os

def get_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, timeout=2).decode().strip()
    except Exception:
        return ""

class WifiDialog(Gtk.Window):
    def __init__(self):
        super().__init__(title="Status Wi-Fi")
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_border_width(12)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)

        self.connect("key-press-event", lambda w, e: self.close_win() if e.keyval == Gdk.KEY_Escape else False)
        self.connect("focus-out-event", lambda w, e: self.close_win())

        css = b'''
        window {
            background-color: #222222;
            border: 1px solid #444444;
            border-radius: 12px;
            color: #ffffff;
            font-family: 'Ubuntu', sans-serif;
        }
        .title {
            font-size: 13pt;
            font-weight: 700;
            color: #ffffff;
        }
        .card {
            background-color: #2c2c2c;
            border: 1px solid #3c3c3c;
            border-radius: 8px;
            padding: 10px;
        }
        .btn-orange {
            background-color: #e95420;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 8px 14px;
            font-weight: 700;
        }
        .btn-orange:hover {
            background-color: #ff6b3b;
        }
        .btn-gray {
            background-color: #383838;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 8px 14px;
            font-weight: 700;
        }
        .btn-gray:hover {
            background-color: #484848;
        }
        '''
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(main_box)

        lbl_title = Gtk.Label(label="<b>📶 Status Jaringan Wi-Fi</b>", use_markup=True, xalign=0)
        lbl_title.get_style_context().add_class("title")
        main_box.pack_start(lbl_title, False, False, 0)

        wifi_raw = get_cmd('adb -s 127.0.0.1:5555 shell dumpsys wifi | grep -m1 "mWifiInfo"')
        ssid = "Tidak Terhubung"
        if 'SSID: "' in wifi_raw:
            ssid = wifi_raw.split('SSID: "')[1].split('"')[0]
        rssi = "-50 dBm"
        if "RSSI: " in wifi_raw:
            try:
                rssi = wifi_raw.split("RSSI: ")[1].split(",")[0].strip() + " dBm"
            except Exception:
                pass
        ip = get_cmd("adb -s 127.0.0.1:5555 shell ip route get 1.1.1.1 2>/dev/null | grep -o 'src [0-9.]*' | awk '{print $2}'") or "10.54.225.89"

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("card")
        
        txt = (
            f"<b>SSID Jaringan:</b> <big><b>{ssid}</b></big>\n"
            f"<b>Status:</b> Terhubung\n"
            f"<b>Alamat IP:</b> {ip}\n"
            f"<b>Kekuatan Sinyal:</b> {rssi}"
        )
        lbl_detail = Gtk.Label(label=txt, use_markup=True, xalign=0)
        card.pack_start(lbl_detail, True, True, 0)
        main_box.pack_start(card, True, True, 0)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_settings = Gtk.Button(label="Buka Pengaturan Android")
        btn_settings.get_style_context().add_class("btn-orange")
        btn_settings.connect("clicked", lambda b: (self.launch_settings(), self.close_win()))

        btn_close = Gtk.Button(label="Tutup")
        btn_close.get_style_context().add_class("btn-gray")
        btn_close.connect("clicked", lambda b: self.close_win())

        btn_box.pack_start(btn_settings, True, True, 0)
        btn_box.pack_start(btn_close, False, False, 0)
        main_box.pack_end(btn_box, False, False, 0)

    def launch_settings(self):
        subprocess.Popen(["adb", "-s", "127.0.0.1:5555", "shell", "am", "start", "-a", "android.settings.WIFI_SETTINGS"])

    def close_win(self):
        self.destroy()
        Gtk.main_quit()

if __name__ == "__main__":
    win = WifiDialog()
    win.set_default_size(320, 220)
    win.show_all()
    Gtk.main()
