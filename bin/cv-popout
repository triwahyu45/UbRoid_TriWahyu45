#!/bin/bash
# ==============================================================================
# UbRoid - Pure OpenCV Pop-Out Launcher
# Menjalankan script Python OpenCV murni dalam Jendela Mengambang HyperOS
# TANPA DESKTOP UBUNTU (Tanpa Dock, Tanpa Taskbar, Tanpa Wallpaper)
# ==============================================================================

SCRIPT="${1:-/root/lane_detector.py}"

echo "🚀 Menyiapkan Pure Pop-Out GUI untuk OpenCV..."

# 1. Matikan komponen desktop XFCE jika sedang hidup agar layar murni jendela Python
pkill -9 -f xfce4-panel 2>/dev/null || true
pkill -9 -f xfdesktop 2>/dev/null || true
pkill -9 -f xfce4-session 2>/dev/null || true

# 2. Pastikan X11 display server aktif di Termux host
if ! pgrep -f "termux-x11" >/dev/null 2>&1; then
    echo "cmd:rm -f /data/data/com.termux/files/usr/tmp/.X11-unix/X0 && termux-x11 :0 -ac &" > /sdcard/.ubroid_launch_trigger
    sleep 0.8
fi

# 3. Buat symlink socket X0 jika belum ada
mkdir -p /tmp/.X11-unix 2>/dev/null || true
ln -sf /data/data/com.termux/files/usr/tmp/.X11-unix/X0 /tmp/.X11-unix/X0 2>/dev/null || true

# 4. Atur preferensi Termux-X11 agar murni seukuran jendela OpenCV (640x480)
if [ -x "/system/bin/am" ]; then
    /system/bin/am broadcast --user 0 -a com.termux.x11.CHANGE_PREFERENCE -p com.termux.x11 \
      --es displayResolutionMode exact \
      --es displayScale 100 \
      --es fullscreen false \
      --es hideCutout true 2>/dev/null || true
fi

# 5. Buka Termux-X11 langsung ke mode Jendela Mengambang (Floating Window HyperOS)
if command -v adb >/dev/null 2>&1; then
    adb -s 127.0.0.1:5555 shell am start -n com.termux.x11/com.termux.x11.MainActivity --windowingMode 5 >/dev/null 2>&1 || true
fi

# 6. Eksekusi script Python OpenCV dengan DISPLAY=:0
export DISPLAY=:0
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

echo "✓ Jendela Mengambang siap! Menjalankan $SCRIPT..."
exec python3 "$SCRIPT" "${@:2}"
