#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk
import subprocess
import os

def get_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, timeout=2).decode().strip()
    except Exception:
        return ""

class VolumeDialog(Gtk.Window):
    def __init__(self):
        super().__init__(title="Kontrol Volume")
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_border_width(12)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)

        self.connect("key-press-event", lambda w, e: self.close_win() if e.keyval == Gdk.KEY_Escape else False)
        # self.connect("focus-out-event", lambda w, e: self.close_win())

        css = b'''
        window {
            background-color: #222222;
            border: 1px solid #444444;
            border-radius: 12px;
            color: #ffffff;
            font-family: 'Ubuntu', sans-serif;
        }
        .title {
            font-size: 13pt;
            font-weight: 700;
            color: #ffffff;
        }
        .card {
            background-color: #2c2c2c;
            border: 1px solid #3c3c3c;
            border-radius: 8px;
            padding: 12px;
        }
        .btn-gray {
            background-color: #383838;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 8px 14px;
            font-weight: 700;
        }
        .btn-gray:hover {
            background-color: #484848;
        }
        scale trough {
            background-color: #3a3a3a;
            border-radius: 6px;
            min-height: 10px;
        }
        scale highlight {
            background-color: #e95420;
            border-radius: 6px;
        }
        scale slider {
            min-width: 20px;
            min-height: 20px;
            border-radius: 10px;
            background-color: #ffffff;
            border: 2px solid #e95420;
        }
        '''
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(main_box)

        lbl_title = Gtk.Label(label="<b>🔊 Kontrol Volume Suara</b>", use_markup=True, xalign=0)
        lbl_title.get_style_context().add_class("title")
        main_box.pack_start(lbl_title, False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.get_style_context().add_class("card")

        vol_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.btn_mute = Gtk.Button(label="🔊")
        self.btn_mute.connect("clicked", self.toggle_mute)

        curr_vol = self.get_vol()
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        self.scale.set_value(curr_vol)
        self.scale.set_hexpand(True)
        self.scale.set_value_pos(Gtk.PositionType.RIGHT)
        self.scale.connect("value-changed", self.on_change)

        vol_row.pack_start(self.btn_mute, False, False, 0)
        vol_row.pack_start(self.scale, True, True, 0)
        card.pack_start(vol_row, False, False, 0)
        main_box.pack_start(card, True, True, 0)

        btn_close = Gtk.Button(label="Tutup")
        btn_close.get_style_context().add_class("btn-gray")
        btn_close.connect("clicked", lambda b: self.close_win())
        main_box.pack_end(btn_close, False, False, 0)

    def get_vol(self):
        try:
            out = get_cmd("pactl get-sink-volume @DEFAULT_SINK@")
            if "%" in out:
                return int(out.split("%")[0].split("/")[-1].strip())
        except Exception:
            pass
        return 80

    def on_change(self, scale):
        val = int(scale.get_value())
        subprocess.Popen(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{val}%"])

    def toggle_mute(self, btn):
        subprocess.call(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle"])
        is_muted = "yes" in get_cmd("pactl get-sink-mute @DEFAULT_SINK@")
        btn.set_label("🔇" if is_muted else "🔊")

    def close_win(self):
        self.destroy()
        Gtk.main_quit()

if __name__ == "__main__":
    win = VolumeDialog()
    win.set_default_size(320, 180)
    win.show_all()
    Gtk.main()
