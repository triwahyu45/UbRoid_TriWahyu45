    background-color: rgba(18, 9, 20, 0.96);
    color: #ffffff;
    font-family: 'Ubuntu', -apple-system, sans-serif;
}

.spread-header {
    padding: 16px 20px 8px 20px;
}

.spread-title {
    font-size: 16pt;
    font-weight: 700;
