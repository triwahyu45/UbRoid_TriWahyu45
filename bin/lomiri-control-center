#!/usr/bin/env python3
"""
UbRoid - Lomiri Indicator & Quick Settings Sheet
Official Ubuntu Touch / Suru Design Language for Android (POCO F6)
"""

import os
import sys
import subprocess
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib

if 'DISPLAY' not in os.environ:
    os.environ['DISPLAY'] = ':0'

UBUNTU_ORANGE = "#E95420"
UBUNTU_AUBERGINE = "#77216F"

def run_cmd(cmd, timeout=2):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, timeout=timeout).decode().strip()
    except Exception:
        return ""

def adb_cmd(cmd, timeout=2):
    return run_cmd(f"adb -s 127.0.0.1:5555 shell {cmd}", timeout=timeout)

CSS_STYLES = b"""
