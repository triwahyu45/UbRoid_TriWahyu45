#!/usr/bin/env bash
# ==============================================================================
# usb-tether-watcher: Pantau status USB Tethering dan deteksi IP Mini PC (Host)
# ==============================================================================

STATE_FILE="/tmp/.usb_tether_state"
CHECK_INTERVAL=3
NOTIF_ID="ubroid-usb-tether"
TERMUX_NOTIF="/data/data/com.termux/files/usr/bin/termux-notification"
TERMUX_NOTIF_REM="/data/data/com.termux/files/usr/bin/termux-notification-remove"

find_mini_pc_ip() {
    python3 -c "import socket
for iface in ['rndis0', 'usb0', 'eth0']:
    try:
        import subprocess
        out = subprocess.check_output(f'ip -4 addr show {iface}', shell=True, stderr=subprocess.DEVNULL).decode()
        for line in out.splitlines():
            line = line.strip()
            if line.startswith('inet '):
                my_ip = line.split()[1].split('/')[0]
                prefix = '.'.join(my_ip.split('.')[:3])
                my_last = int(my_ip.split('.')[3])
                # Coba cari host aktif di subnet (prioritaskan 1, 100-254)
                candidates = [1] + [i for i in range(100, 255) if i != my_last] + [i for i in range(2, 100)]
                for i in candidates:
                    target = f'{prefix}.{i}'
                    for port in [47989, 47984, 22, 3389]:
                        s = socket.socket()
                        s.settimeout(0.04)
                        try:
                            s.connect((target, port))
                            s.close()
                            print(f'{iface} {target}')
                            exit(0)
                        except Exception:
                            pass
    except Exception:
        pass
" 2>/dev/null
}

show_ongoing_notif() {
    local iface="$1"
    local ip_addr="$2"

    # Notifikasi Android Ongoing (pinned / tidak bisa di-swipe)
    if [ -x "$TERMUX_NOTIF" ]; then
        "$TERMUX_NOTIF" \
            --id "$NOTIF_ID" \
            --title "USB Tethering Aktif ($iface)" \
            --content "IP Mini PC: $ip_addr" \
            --icon "settings_ethernet" \
            --priority "high" \
            --ongoing \
            2>/dev/null || true
    fi

    # Notifikasi desktop Linux (sekali muncul)
    if [ -n "$DISPLAY" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i network-wired "USB Tethering Terhubung" "IP Mini PC: $ip_addr ($iface)" 2>/dev/null || true
    fi
}

remove_notif() {
    if [ -x "$TERMUX_NOTIF_REM" ]; then
        "$TERMUX_NOTIF_REM" "$NOTIF_ID" 2>/dev/null || true
    fi
    if [ -n "$DISPLAY" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u low -i network-wired-disconnected "USB Tethering Terputus" "Koneksi USB Tethering telah dinonaktifkan." 2>/dev/null || true
    fi
}

LAST_STATE="OFF"
LAST_IP=""

while true; do
    res=$(find_mini_pc_ip)
    if [ -n "$res" ]; then
        curr_iface=$(echo "$res" | awk '{print $1}')
        curr_ip=$(echo "$res" | awk '{print $2}')
        curr_state="ON"

        if [ "$LAST_STATE" != "ON" ] || [ "$LAST_IP" != "$curr_ip" ]; then
            show_ongoing_notif "$curr_iface" "$curr_ip"
            echo "ON:$curr_iface:$curr_ip" > "$STATE_FILE"
            LAST_STATE="ON"
            LAST_IP="$curr_ip"
        fi
    else
        # Jika tidak ada host mini PC yang terdeteksi
        curr_state="OFF"
        if [ "$LAST_STATE" == "ON" ]; then
            remove_notif
            echo "OFF" > "$STATE_FILE"
            LAST_STATE="OFF"
            LAST_IP=""
        fi
    fi

    sleep "$CHECK_INTERVAL"
done
