#!/usr/bin/env python3
# ==============================================================================
# usb-tether-watcher: Pantau status USB Tethering dan kelola notifikasi ongoing
# Menampilkan IP Mini PC (Host) yang aktif (Sunshine / SSH / RDP)
# Otomatis memperbarui /etc/hosts (minipc / AbhinayaNuc) secara permanen
# ==============================================================================

import concurrent.futures
import socket
import subprocess
import time
import os
import re

STATE_FILE = "/tmp/.usb_tether_state"
CACHE_FILE = "/tmp/.last_tether_ip"
NOTIF_ID = "ubroid-usb-tether"
TERMUX_NOTIF = "/data/data/com.termux/files/usr/bin/termux-notification"
TERMUX_NOTIF_REM = "/data/data/com.termux/files/usr/bin/termux-notification-remove"

def is_alive(ip):
    # Sunshine (47989/47984), SSH (22), RDP (3389)
    for port in [47989, 47984, 22, 3389]:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.1)
        try:
            s.connect((ip, port))
            s.close()
            return True
        except Exception:
            s.close()
    return False

def check_target(args):
    prefix, last, my_last = args
    if last == my_last:
        return None
    target = f"{prefix}.{last}"
    if is_alive(target):
        return target
    return None

def update_hosts(ip, hostname="minipc", alias="AbhinayaNuc"):
    hosts_path = "/etc/hosts"
    try:
        if not os.path.exists(hosts_path):
            return
        with open(hosts_path, "r") as f:
            lines = f.readlines()
        new_lines = []
        replaced = False
        for line in lines:
            if re.search(r'\b' + hostname + r'\b', line) or re.search(r'\b' + alias + r'\b', line):
                new_lines.append(f"{ip}\t{hostname}\t{alias}\n")
                replaced = True
            else:
                new_lines.append(line)
        if not replaced:
            new_lines.append(f"{ip}\t{hostname}\t{alias}\n")
        with open(hosts_path, "w") as f:
            f.writelines(new_lines)
    except Exception:
        pass

def find_mini_pc():
    for iface in ['rndis0', 'usb0', 'eth0']:
        try:
            out = subprocess.check_output(f"ip -4 addr show {iface}", shell=True, stderr=subprocess.DEVNULL).decode()
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("inet "):
                    my_ip = line.split()[1].split("/")[0]
                    parts = my_ip.split(".")
                    prefix = ".".join(parts[:3])
                    my_last = int(parts[3])

                    # 1. Cek cache IP terakhir jika subnet masih cocok
                    try:
                        if os.path.exists(CACHE_FILE):
                            with open(CACHE_FILE, "r") as f:
                                cached = f.read().strip()
                            if cached.startswith(prefix) and is_alive(cached):
                                return iface, cached
                    except Exception:
                        pass

                    # 2. Cek IP kandidat cepat (gateway .1, host .198, .172, .2, .100)
                    quick_candidates = [1, 198, 172, 2, 100, 254]
                    for last in quick_candidates:
                        if last == my_last:
                            continue
                        target = f"{prefix}.{last}"
                        if is_alive(target):
                            try:
                                with open(CACHE_FILE, "w") as f:
                                    f.write(target)
                            except Exception:
                                pass
                            return iface, target

                    # 3. Pindai cepat paralel seluruh range jika belum ketemu
                    tasks = [(prefix, last, my_last) for last in range(1, 255) if last not in quick_candidates]
                    with concurrent.futures.ThreadPoolExecutor(max_workers=30) as executor:
                        results = executor.map(check_target, tasks)
                        for res in results:
                            if res:
                                try:
                                    with open(CACHE_FILE, "w") as f:
                                        f.write(res)
                                except Exception:
                                    pass
                                return iface, res

                    # Fallback jika host belum menyalakan Sunshine/SSH tapi tethering aktif
                    return iface, f"{prefix}.1 (perkiraan)"
        except Exception:
            pass
    return None, None

def show_notif(iface, ip_addr):
    # 1. Ongoing Notification di Android (tidak bisa di-swipe)
    cmd = [
        TERMUX_NOTIF,
        "--id", NOTIF_ID,
        "--title", f"USB Tethering Aktif ({iface})",
        "--content", f"IP Mini PC: {ip_addr}",
        "--icon", "settings_ethernet",
        "--priority", "high",
        "--ongoing"
    ]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # 2. X11 Desktop notify-send jika desktop session aktif
    if os.environ.get("DISPLAY"):
        try:
            subprocess.run([
                "notify-send", "-u", "normal", "-i", "network-wired",
                "USB Tethering Terhubung", f"IP Mini PC: {ip_addr} ({iface})"
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def remove_notif():
    # Hilangkan notifikasi di Android
    try:
        subprocess.run([TERMUX_NOTIF_REM, NOTIF_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    if os.environ.get("DISPLAY"):
        try:
            subprocess.run([
                "notify-send", "-u", "low", "-i", "network-wired-disconnected",
                "USB Tethering Terputus", "Koneksi USB Tethering telah dinonaktifkan."
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def main():
    last_state = "OFF"
    last_ip = ""

    # Bersihkan notifikasi jika saat daemon start tethering tidak aktif
    iface, ip_addr = find_mini_pc()
    if not iface:
        remove_notif()

    while True:
        iface, ip_addr = find_mini_pc()
        if iface and ip_addr:
            if last_state != "ON" or last_ip != ip_addr:
                show_notif(iface, ip_addr)
                # Simpan state dan perbarui /etc/hosts otomatis permanen
                try:
                    with open(STATE_FILE, "w") as f:
                        f.write(f"ON:{iface}:{ip_addr}")
                except Exception:
                    pass
                update_hosts(ip_addr)
                last_state = "ON"
                last_ip = ip_addr
        else:
            if last_state == "ON":
                remove_notif()
                try:
                    with open(STATE_FILE, "w") as f:
                        f.write("OFF")
                except Exception:
                    pass
                last_state = "OFF"
                last_ip = ""

        time.sleep(3)

if __name__ == "__main__":
    main()
