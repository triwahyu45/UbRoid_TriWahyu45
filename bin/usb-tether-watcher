#!/usr/bin/env bash
# ==============================================================================
# usb-tether-watcher: Pantau status USB Tethering dan kelola notifikasi ongoing
# ==============================================================================

STATE_FILE="/tmp/.usb_tether_state"
CHECK_INTERVAL=3
NOTIF_ID="ubroid-usb-tether"
TERMUX_NOTIF="/data/data/com.termux/files/usr/bin/termux-notification"
TERMUX_NOTIF_REM="/data/data/com.termux/files/usr/bin/termux-notification-remove"

get_tether_ip() {
    # Periksa antarmuka USB Tethering umum: rndis0, usb0, eth0
    for iface in rndis0 usb0 eth0; do
        local addr
        addr=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1)
        if [ -n "$addr" ]; then
            echo "$iface $addr"
            return 0
        fi
    done
    return 1
}

show_ongoing_notif() {
    local iface="$1"
    local ip_addr="$2"

    # Notifikasi Android Ongoing (pinned / tidak bisa di-swipe)
    if [ -x "$TERMUX_NOTIF" ]; then
        "$TERMUX_NOTIF" \
            --id "$NOTIF_ID" \
            --title "USB Tethering Aktif ($iface)" \
            --content "IP Mini PC: $ip_addr" \
            --icon "settings_ethernet" \
            --priority "high" \
            --ongoing \
            2>/dev/null || true
    fi

    # Notifikasi desktop Linux (sekali muncul)
    if [ -n "$DISPLAY" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i network-wired "USB Tethering Terhubung" "IP Mini PC: $ip_addr ($iface)" 2>/dev/null || true
    fi
}

remove_notif() {
    # Hapus notifikasi Android secara otomatis
    if [ -x "$TERMUX_NOTIF_REM" ]; then
        "$TERMUX_NOTIF_REM" "$NOTIF_ID" 2>/dev/null || true
    fi

    # Desktop pop-up saat terputus
    if [ -n "$DISPLAY" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u low -i network-wired-disconnected "USB Tethering Terputus" "Koneksi USB Tethering telah dinonaktifkan." 2>/dev/null || true
    fi
}

LAST_STATE="OFF"
LAST_IP=""

# Hapus notifikasi sisa sesi sebelumnya jika ada saat start
if ! get_tether_ip >/dev/null 2>&1; then
    remove_notif
fi

while true; do
    if res=$(get_tether_ip); then
        curr_iface=$(echo "$res" | awk '{print $1}')
        curr_ip=$(echo "$res" | awk '{print $2}')
        curr_state="ON"

        # Tampilkan atau perbarui notifikasi jika baru aktif atau IP berubah
        if [ "$LAST_STATE" != "ON" ] || [ "$LAST_IP" != "$curr_ip" ]; then
            show_ongoing_notif "$curr_iface" "$curr_ip"
            echo "ON:$curr_iface:$curr_ip" > "$STATE_FILE"
            LAST_STATE="ON"
            LAST_IP="$curr_ip"
        fi
    else
        curr_state="OFF"
        # Jika sebelumnya ON dan sekarang mati, hilangkan notifikasi secara otomatis
        if [ "$LAST_STATE" == "ON" ]; then
            remove_notif
            echo "OFF" > "$STATE_FILE"
            LAST_STATE="OFF"
            LAST_IP=""
        fi
    fi

    sleep "$CHECK_INTERVAL"
done
