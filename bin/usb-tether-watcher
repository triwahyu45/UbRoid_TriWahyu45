#!/usr/bin/env bash
# ==============================================================================
# usb-tether-watcher: Pantau status USB Tethering dan kirim notifikasi otomatis
# ==============================================================================

STATE_FILE="/tmp/.usb_tether_state"
CHECK_INTERVAL=3
TERMUX_NOTIF="/data/data/com.termux/files/usr/bin/termux-notification"

get_tether_ip() {
    # Periksa antarmuka USB Tethering umum: rndis0, usb0, eth0
    for iface in rndis0 usb0 eth0; do
        local addr
        addr=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1)
        if [ -n "$addr" ]; then
            echo "$iface $addr"
            return 0
        fi
    done
    return 1
}

send_notif() {
    local title="$1"
    local message="$2"
    local prio="${3:-high}"

    # 1. Notifikasi Android langsung di HP (Termux API)
    if [ -x "$TERMUX_NOTIF" ]; then
        "$TERMUX_NOTIF" \
            --id "ubroid-usb-tether" \
            --title "$title" \
            --content "$message" \
            --priority "$prio" \
            2>/dev/null || true
    fi

    # 2. Notifikasi desktop X11 jika desktop sedang aktif
    if [ -n "$DISPLAY" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -i network-wired "$title" "$message" 2>/dev/null || true
    fi
}

# Inisialisasi state awal
LAST_STATE="OFF"
LAST_IP=""

while true; do
    if res=$(get_tether_ip); then
        curr_iface=$(echo "$res" | awk '{print $1}')
        curr_ip=$(echo "$res" | awk '{print $2}')
        curr_state="ON"

        # Kirim notifikasi jika status baru menyala atau IP berubah
        if [ "$LAST_STATE" != "ON" ] || [ "$LAST_IP" != "$curr_ip" ]; then
            send_notif "USB Tethering Aktif ($curr_iface)" "IP Mini PC: $curr_ip" "high"
            echo "ON:$curr_iface:$curr_ip" > "$STATE_FILE"
            LAST_STATE="ON"
            LAST_IP="$curr_ip"
        fi
    else
        curr_state="OFF"
        if [ "$LAST_STATE" == "ON" ]; then
            send_notif "USB Tethering Terputus" "Koneksi USB Tethering telah dinonaktifkan." "default"
            echo "OFF" > "$STATE_FILE"
            LAST_STATE="OFF"
            LAST_IP=""
        fi
    fi

    sleep "$CHECK_INTERVAL"
done
