#!/usr/bin/env python3
"""
UbRoid Window Snap Engine & Multi-Window Layout Manager
Supports Full 3-Tier Vertical Stacking (Left/Right Top, Middle, Bottom)
Custom-tailored for Android Portrait (808x1725)
"""
import ctypes
import os
import re
import subprocess
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib


class XSizeHints(ctypes.Structure):
    _fields_ = [
        ("flags", ctypes.c_long),
        ("x", ctypes.c_int), ("y", ctypes.c_int),
        ("width", ctypes.c_int), ("height", ctypes.c_int),
        ("min_width", ctypes.c_int), ("min_height", ctypes.c_int),
        ("max_width", ctypes.c_int), ("max_height", ctypes.c_int),
        ("width_inc", ctypes.c_int), ("height_inc", ctypes.c_int),
        ("min_aspect_x", ctypes.c_int), ("min_aspect_y", ctypes.c_int),
        ("max_aspect_x", ctypes.c_int), ("max_aspect_y", ctypes.c_int),
        ("base_width", ctypes.c_int), ("base_height", ctypes.c_int),
        ("win_gravity", ctypes.c_int),
    ]


def run_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
    except Exception:
        return ""


def get_workarea():
    out = run_cmd("xprop -root _NET_WORKAREA")
    m = re.search(r"=\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)", out)
    if m:
        return int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
    return 0, 48, 808, 1530


def get_frame_extents(wid_hex):
    gtk_out = run_cmd(f"xprop -id {wid_hex} _GTK_FRAME_EXTENTS")
    m = re.search(r"=\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)", gtk_out)
    if m:
        gl, gr, gt, gb = int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
        if gl > 0 or gr > 0 or gt > 0 or gb > 0:
            return True, gl, gr, gt, gb

    net_out = run_cmd(f"xprop -id {wid_hex} _NET_FRAME_EXTENTS")
    m = re.search(r"=\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)", net_out)
    if m:
        return False, int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))

    return False, 0, 0, 0, 0


def relax_window_constraints(wid_hex):
    try:
        x11 = ctypes.CDLL("libX11.so.6")
        disp = x11.XOpenDisplay(None)
        if disp:
            w_int = int(wid_hex, 16) if isinstance(wid_hex, str) else wid_hex
            hints = XSizeHints()
            hints.flags = (1 << 4) | (1 << 8)  # PMinSize | PBaseSize
            hints.min_width = 200
            hints.min_height = 100
            hints.base_width = 200
            hints.base_height = 100
            x11.XSetWMNormalHints(disp, w_int, ctypes.byref(hints))
            x11.XFlush(disp)
            x11.XCloseDisplay(disp)
    except Exception:
        pass


def get_normal_windows_stacking():
    active_out = run_cmd("xprop -root _NET_ACTIVE_WINDOW")
    m_act = re.search(r"0x[0-9a-fA-F]+", active_out)
    active_wid = m_act.group(0) if m_act else None

    stack_out = run_cmd("xprop -root _NET_CLIENT_LIST_STACKING")
    raw_ids = re.findall(r"0x[0-9a-fA-F]+", stack_out)
    if not raw_ids:
        wm_out = run_cmd("wmctrl -l")
        raw_ids = [line.split()[0] for line in wm_out.splitlines() if line.strip()]

    raw_ids = list(reversed(raw_ids))
    valid_windows = []
    for wid in raw_ids:
        if int(wid, 16) == 0:
            continue
        props = run_cmd(f"xprop -id {wid} _NET_WM_WINDOW_TYPE WM_CLASS _NET_WM_NAME WM_NAME")
        if "_NET_WM_WINDOW_TYPE_DOCK" in props or "_NET_WM_WINDOW_TYPE_DESKTOP" in props:
            continue
        if "xfce4-panel" in props.lower() or "xfdesktop" in props.lower() or "snap-layout" in props.lower() or "macos-launchpad" in props.lower():
            continue
        valid_windows.append(wid)

    if active_wid and active_wid in valid_windows:
        valid_windows.remove(active_wid)
        valid_windows.insert(0, active_wid)

    return valid_windows


def place_window(wid, x, y, w, h, gap=2):
    bx = int(x + gap)
    by = int(y + gap)
    bw = max(160, int(w - gap * 2))
    bh = max(100, int(h - gap * 2))

    relax_window_constraints(wid)

    subprocess.call(
        f"wmctrl -i -r {wid} -b remove,maximized_vert,maximized_horz,fullscreen,shaded",
        shell=True,
        stderr=subprocess.DEVNULL,
    )
    subprocess.call(f"xdotool windowmap {wid}", shell=True, stderr=subprocess.DEVNULL)

    is_csd, left, right, top, bottom = get_frame_extents(wid)

    if is_csd:
        target_x = bx - left
        target_y = by - top
        target_w = bw + left + right
        target_h = bh + top + bottom
    else:
        target_x = bx
        target_y = by
        target_w = max(160, bw - left - right)
        target_h = max(100, bh - top - bottom)

    subprocess.call(
        f"wmctrl -i -r {wid} -e 0,{target_x},{target_y},{target_w},{target_h}",
        shell=True,
        stderr=subprocess.DEVNULL,
    )
    subprocess.call(
        f"xdotool windowsize {wid} {target_w} {target_h} && xdotool windowmove {wid} {target_x} {target_y}",
        shell=True,
        stderr=subprocess.DEVNULL,
    )
    subprocess.call(f"wmctrl -i -a {wid}", shell=True, stderr=subprocess.DEVNULL)


def apply_layout(mode, target_windows=None):
    wx, wy, ww, wh = get_workarea()
    wins = target_windows if target_windows is not None else get_normal_windows_stacking()
    if not wins:
        return

    w0 = wins[0]
    w1 = wins[1] if len(wins) > 1 else None
    w2 = wins[2] if len(wins) > 2 else None
    w3 = wins[3] if len(wins) > 3 else None
    w4 = wins[4] if len(wins) > 4 else None
    w5 = wins[5] if len(wins) > 5 else None

    half_w = ww // 2
    half_h = wh // 2
    tier_h = wh // 3

    # Half Snaps
    if mode == "left-half":
        place_window(w0, wx, wy, half_w, wh)
    elif mode == "right-half":
        place_window(w0, wx + half_w, wy, ww - half_w, wh)
    elif mode == "top-half":
        place_window(w0, wx, wy, ww, half_h)
    elif mode == "bottom-half":
        place_window(w0, wx, wy + half_h, ww, wh - half_h)

    # 3-Tier Vertical Snaps for Left Side
    elif mode == "left-top":
        place_window(w0, wx, wy, half_w, tier_h)
    elif mode == "left-middle":
        place_window(w0, wx, wy + tier_h, half_w, tier_h)
    elif mode == "left-bottom":
        place_window(w0, wx, wy + tier_h * 2, half_w, wh - tier_h * 2)

    # 3-Tier Vertical Snaps for Right Side
    elif mode == "right-top":
        place_window(w0, wx + half_w, wy, ww - half_w, tier_h)
    elif mode == "right-middle":
        place_window(w0, wx + half_w, wy + tier_h, ww - half_w, tier_h)
    elif mode == "right-bottom":
        place_window(w0, wx + half_w, wy + tier_h * 2, ww - half_w, wh - tier_h * 2)

    # 4 Quarters
    elif mode == "top-left":
        place_window(w0, wx, wy, half_w, half_h)
    elif mode == "top-right":
        place_window(w0, wx + half_w, wy, ww - half_w, half_h)
    elif mode == "bottom-left":
        place_window(w0, wx, wy + half_h, half_w, wh - half_h)
    elif mode == "bottom-right":
        place_window(w0, wx + half_w, wy + half_h, ww - half_w, wh - half_h)

    # Multi-Window Automatic Split Layouts
    elif mode == "split-lr-50":
        if w1:
            place_window(w1, wx + half_w, wy, ww - half_w, wh)
        place_window(w0, wx, wy, half_w, wh)
    elif mode == "split-tb-50":
        if w1:
            place_window(w1, wx, wy + half_h, ww, wh - half_h)
        place_window(w0, wx, wy, ww, half_h)
    elif mode == "split-vertical-3":
        if w2:
            place_window(w2, wx, wy + tier_h * 2, ww, wh - tier_h * 2)
        if w1:
            place_window(w1, wx, wy + tier_h, ww, tier_h)
        place_window(w0, wx, wy, ww, tier_h)
    elif mode == "split-3":
        if w2:
            place_window(w2, wx + half_w, wy + half_h, ww - half_w, wh - half_h)
        if w1:
            place_window(w1, wx + half_w, wy, ww - half_w, half_h)
        place_window(w0, wx, wy, half_w, wh)
    elif mode == "split-6":
        # 3 on left, 3 on right
        if w5:
            place_window(w5, wx + half_w, wy + tier_h * 2, ww - half_w, wh - tier_h * 2)
        if w4:
            place_window(w4, wx + half_w, wy + tier_h, ww - half_w, tier_h)
        if w3:
            place_window(w3, wx + half_w, wy, ww - half_w, tier_h)
        if w2:
            place_window(w2, wx, wy + tier_h * 2, half_w, wh - tier_h * 2)
        if w1:
            place_window(w1, wx, wy + tier_h, half_w, tier_h)
        place_window(w0, wx, wy, half_w, tier_h)
    elif mode == "maximize":
        subprocess.call(
            f"wmctrl -i -r {w0} -b add,maximized_vert,maximized_horz && wmctrl -i -a {w0}",
            shell=True,
            stderr=subprocess.DEVNULL,
        )
    elif mode == "center":
        cw = int(ww * 0.82)
        ch = int(wh * 0.72)
        cx = wx + (ww - cw) // 2
        cy = wy + (wh - ch) // 2
        place_window(w0, cx, cy, cw, ch)


class SnapLayoutPopup(Gtk.Window):
    def __init__(self, captured_windows):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.captured_windows = captured_windows
        self.set_title("Snap Layouts")
        self.set_role("snap-layout")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_resizable(False)

        wx, wy, ww, wh = get_workarea()
        win_w = 680
        self.move(wx + (ww - win_w) // 2, wy + 8)

        css = b"""
        window {
            background-color: #1a1a1c;
            border: 2px solid #e95420;
            border-radius: 18px;
            color: #ffffff;
        }
        .header-title {
            font-size: 15px;
            font-weight: bold;
            color: #ffffff;
        }
        .header-sub {
            font-size: 11px;
            color: #b8b5ae;
        }
        .layout-btn {
            background-color: #27272a;
            border: 1px solid #3f3f46;
            border-radius: 12px;
            padding: 8px 10px;
            color: #f4f4f5;
            font-weight: 600;
            font-size: 12px;
        }
        .layout-btn:hover {
            background-color: rgba(233, 84, 32, 0.35);
            border: 1px solid #e95420;
            color: #ffffff;
        }
        .close-btn {
            background-color: #3f3f46;
            border-radius: 50%;
            min-width: 32px;
            min-height: 32px;
            padding: 0;
            color: #ffffff;
            font-weight: bold;
        }
        .close-btn:hover {
            background-color: #df382c;
        }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.set_margin_top(12)
        outer.set_margin_bottom(14)
        outer.set_margin_start(14)
        outer.set_margin_end(14)
        self.add(outer)

        # Header row
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(label="⊞ Snap Windows (Sentuh Layout Pilihan)", xalign=0)
        lbl_title.get_style_context().add_class("header-title")
        lbl_sub = Gtk.Label(
            label="Mendukung Snap 3 Tingkat Vertikal (Atas, Tengah, Bawah) untuk HP Portrait:",
            xalign=0,
        )
        lbl_sub.get_style_context().add_class("header-sub")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        btn_close = Gtk.Button(label="✕")
        btn_close.get_style_context().add_class("close-btn")
        btn_close.connect("clicked", lambda *_: Gtk.main_quit())
        header.pack_end(btn_close, False, False, 0)
        outer.pack_start(header, False, False, 0)

        grid = Gtk.Grid()
        grid.set_column_spacing(8)
        grid.set_row_spacing(8)
        grid.set_column_homogeneous(True)
        outer.pack_start(grid, True, True, 0)

        layouts = [
            # Row 0: Kiri 3 Tingkat
            ("left-top", "◀▲ Kiri Atas\n(1/3 Tinggi)", 0, 0),
            ("left-middle", "◀■ Kiri Tengah\n(1/3 Tinggi)", 1, 0),
            ("left-bottom", "◀▼ Kiri Bawah\n(1/3 Tinggi)", 2, 0),
            ("left-half", "◀ Kiri Penuh\n(Setengah Kiri)", 3, 0),

            # Row 1: Kanan 3 Tingkat
            ("right-top", "▶▲ Kanan Atas\n(1/3 Tinggi)", 0, 1),
            ("right-middle", "▶■ Kanan Tengah\n(1/3 Tinggi)", 1, 1),
            ("right-bottom", "▶▼ Kanan Bawah\n(1/3 Tinggi)", 2, 1),
            ("right-half", "▶ Kanan Penuh\n(Setengah Kanan)", 3, 1),

            # Row 2: Layar Penuh, Vertikal 3 & Multi Windows
            ("top-half", "▲ Setengah Atas\n(Layar Lebar)", 0, 2),
            ("bottom-half", "▼ Setengah Bawah\n(Layar Lebar)", 1, 2),
            ("split-vertical-3", "☰ 3 Jendela Vertikal\n(Tingkat 1-2-3)", 2, 2),
            ("maximize", "⬜ Layar Penuh\n(Maximize)", 3, 2),
        ]

        for mode, text, col, row in layouts:
            btn = Gtk.Button(label=text)
            btn.get_style_context().add_class("layout-btn")
            btn.connect("clicked", self.on_select_layout, mode)
            grid.attach(btn, col, row, 1, 1)

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", Gtk.main_quit)

    def on_key_press(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()

    def on_select_layout(self, _btn, mode):
        self.hide()
        while Gtk.events_pending():
            Gtk.main_iteration()
        apply_layout(mode, self.captured_windows)
        Gtk.main_quit()


def main():
    if len(sys.argv) > 1 and sys.argv[1] not in ("--popup", "--popup-top"):
        target_windows = [sys.argv[2]] if len(sys.argv) > 2 else None
        apply_layout(sys.argv[1], target_windows)
        return

    existing = run_cmd("pgrep -f '/usr/local/bin/snap-layout --popup'").splitlines()
    my_pid = str(os.getpid())
    other_pids = [p.strip() for p in existing if p.strip() and p.strip() != my_pid]
    if other_pids:
        for p in other_pids:
            subprocess.call(f"kill -9 {p}", shell=True, stderr=subprocess.DEVNULL)
        return

    captured = get_normal_windows_stacking()
    win = SnapLayoutPopup(captured)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
