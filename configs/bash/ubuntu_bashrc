    echo -e "\033[1;38;2;255;170;0m |____/ \___|\__|_|  \___/|_| |_|_|\___|___/|___|____/ \033[0m"
    echo -e "\033[1;38;2;255;120;0m ──────────────────────────────────────────────────────\033[0m"
    echo -e "\033[1;37mWelcome to Ubuntu 24.04 LTS (Noble Numbat aarch64) - $DEV_NAME\033[0m"
