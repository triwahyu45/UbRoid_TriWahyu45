# Safe exit confirmation for interactive shells (Keep Ubuntu Running)
if [[ $- == *i* ]]; then
    safe_exit() {
        if pgrep -x "xfce4-session" >/dev/null 2>&1; then
            echo -e "\033[1;33m[!] Catatan: Sesi Desktop XFCE sedang berjalan di latar belakang.\033[0m"
            echo -e "    • Ketik \033[1;32my\033[0m untuk menutup jendela terminal ini saja."
            echo -e "    • Ketik \033[1;31mshutdown-ubuntu\033[0m untuk mematikan seluruh sesi OS Ubuntu."
            read -p "Tutup jendela terminal ini? (y/N): " -r answer
            if [[ "$answer" =~ ^[Yy]$ ]]; then
                builtin exit
            else
                echo -e "\033[1;32m[*] Keluar dibatalkan. Terminal tetap aktif.\033[0m"
            fi
        else
            builtin exit
        fi
    }
    alias exit='safe_exit'
fi
