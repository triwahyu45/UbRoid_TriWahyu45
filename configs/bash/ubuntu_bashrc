# Safe exit confirmation for interactive shells (Keep Ubuntu Running)
if [[ $- == *i* ]]; then
    safe_exit() {
        if pgrep -x "xfce4-session" >/dev/null 2>&1; then
            echo -e "\033[1;33m[!] PERINGATAN: Sesi Desktop XFCE sedang berjalan di latar belakang.\033[0m"
            read -p "Apakah Anda yakin ingin keluar dari terminal ini? (y/N): " -r answer
            if [[ "$answer" =~ ^[Yy]$ ]]; then
                builtin exit
            else
                echo -e "\033[1;32m[*] Keluar dibatalkan. Ubuntu tetap aktif berjalan.\033[0m"
            fi
        else
            builtin exit
        fi
    }
    alias exit='safe_exit'
fi
