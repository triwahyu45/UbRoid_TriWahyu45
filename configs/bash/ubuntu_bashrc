# ~/.bashrc for Ubuntu 24.04 PRoot
DEV_NAME=$(getprop ro.product.marketname 2>/dev/null)
[ -z "$DEV_NAME" ] && DEV_NAME=$(getprop ro.product.model 2>/dev/null)
[ -z "$DEV_NAME" ] && DEV_NAME="Android Device"

export PS1='\[\033[1;38;2;0;255;136m\]root@ubuntu\[\033[0m\]:\[\033[1;38;2;0;210;255m\]\w\[\033[0m\]# '
export TERM=xterm-256color
export LANG=C.UTF-8
export PATH="/usr/local/bin:/root/.local/bin:$PATH"

alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias sudo='sudo '
alias about='dialog-about'
alias agy='/usr/local/bin/agy'
alias agy-turbo='/usr/local/bin/agy'

