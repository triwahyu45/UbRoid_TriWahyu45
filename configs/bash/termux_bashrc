# ~/.bashrc for Termux on Android
DEV_NAME=$(getprop ro.product.marketname 2>/dev/null)
[ -z "$DEV_NAME" ] && DEV_NAME=$(getprop ro.product.model 2>/dev/null)
[ -z "$DEV_NAME" ] && DEV_NAME="Android Device"

export PS1='\[\033[1;32m\]termux@android\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '

# Smart container resolver (ubuntu or ubuntu:24.04)
_get_ubroid_container() {
    if proot-distro list 2>/dev/null | grep -q "^ubuntu\b.*installed"; then
        echo "ubuntu"
    elif proot-distro list 2>/dev/null | grep -q "ubuntu:24.04.*installed"; then
        echo "ubuntu:24.04"
    else
        echo "ubuntu"
    fi
}

# 1-Tap Launcher Functions
# Mode CLI: Ringan & Co-existence dengan Android (notifikasi, WA, telp tetap aktif)
ubuntu() {
    bash ~/launch_ubuntu.sh "$@"
}
alias u="ubuntu"
alias u-port="ubuntu --portrait"
alias u-land="ubuntu --landscape"
alias u-auto="ubuntu --sensor"

# Mode Dedicated Linux OS: Murni meninggalkan Android (ADB suspend app 3rd-party, 100% RAM & CPU)
ubuntu-os() {
    bash ~/launch_ubuntu.sh --dedicated "$@"
}
alias uos="ubuntu-os"
alias uos-port="ubuntu-os --portrait"
alias uos-land="ubuntu-os --landscape"

ubuntu-cli() {
    local c
    c=$(_get_ubroid_container)
    proot-distro login "$c" --bind /sdcard:/sdcard "$@"
}
alias uc="ubuntu-cli"

# Antigravity CLI (AGY) Turbo Mode from Termux
agy() {
    local c
    c=$(_get_ubroid_container)
    proot-distro login "$c" --bind /sdcard:/sdcard -- agy "$@"
}

# 1-Command Permanent Mode Switcher (Ubuntu Touch Mobile <-> Ubuntu Desktop)
switch-mode() {
    local target="${1:-touch}"
    local c
    c=$(_get_ubroid_container)
    proot-distro login "$c" --bind /sdcard:/sdcard -- /usr/local/bin/ubroid-switch-mode "$target"
}
alias touch-mode="switch-mode touch"
alias desktop-mode="switch-mode desktop"

# Wireless ADB Static Port Keeper (Port 5555)
keep-adb() {
    setprop service.adb.tcp.port 5555 2>/dev/null || true
    echo "✓ Port Wireless ADB 5555 terkunci standby."
}

# --- UbRoid APK Launcher Trigger Detection & Background Daemon ---
_handle_ubroid_trigger() {
    local trg=""
    if [ -f "/sdcard/.ubroid_launch_trigger" ]; then
        trg=$(cat "/sdcard/.ubroid_launch_trigger" 2>/dev/null)
        rm -f "/sdcard/.ubroid_launch_trigger" "/sdcard/Download/.ubroid_launch_trigger" 2>/dev/null
    elif [ -f "/sdcard/Download/.ubroid_launch_trigger" ]; then
        trg=$(cat "/sdcard/Download/.ubroid_launch_trigger" 2>/dev/null)
        rm -f "/sdcard/.ubroid_launch_trigger" "/sdcard/Download/.ubroid_launch_trigger" 2>/dev/null
    fi

    if [ -n "$trg" ]; then
        if [ "$trg" = "apk_full_os" ]; then
            echo "🚀 Meluncurkan Ubuntu Dedicated OS Mode dari APK Launcher..."
            bash ~/launch_ubuntu.sh --dedicated
        else
            echo "🚀 Meluncurkan Ubuntu dari APK Launcher..."
            bash ~/launch_ubuntu.sh
        fi
    fi
}

# Check trigger saat login
_handle_ubroid_trigger

# Daemon Background Watcher agar launcher APK tetap bekerja saat Termux standby
if ! pgrep -f "ubroid_watcher" >/dev/null 2>&1; then
    (
        exec -a ubroid_watcher bash -c '
            while true; do
                if [ -f "/sdcard/.ubroid_launch_trigger" ] || [ -f "/sdcard/Download/.ubroid_launch_trigger" ]; then
                    trg=""
                    [ -f "/sdcard/.ubroid_launch_trigger" ] && trg=$(cat "/sdcard/.ubroid_launch_trigger" 2>/dev/null)
                    [ -z "$trg" ] && [ -f "/sdcard/Download/.ubroid_launch_trigger" ] && trg=$(cat "/sdcard/Download/.ubroid_launch_trigger" 2>/dev/null)
                    rm -f "/sdcard/.ubroid_launch_trigger" "/sdcard/Download/.ubroid_launch_trigger" 2>/dev/null
                    if [ "$trg" = "apk_full_os" ]; then
                        bash /data/data/com.termux/files/home/launch_ubuntu.sh --dedicated >/dev/null 2>&1
                    else
                        bash /data/data/com.termux/files/home/launch_ubuntu.sh >/dev/null 2>&1
                    fi
                fi
                sleep 0.5
            done
        '
    ) >/dev/null 2>&1 &
fi

