# ~/.bashrc for Termux on Android
DEV_NAME=$(getprop ro.product.marketname 2>/dev/null)
[ -z "$DEV_NAME" ] && DEV_NAME=$(getprop ro.product.model 2>/dev/null)
[ -z "$DEV_NAME" ] && DEV_NAME="Android Device"

export PS1='\[\033[1;32m\]termux@android\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '

# Smart container resolver (ubuntu or ubuntu:24.04)
_get_ubroid_container() {
    if proot-distro list 2>/dev/null | grep -q "^ubuntu\b.*installed"; then
        echo "ubuntu"
    elif proot-distro list 2>/dev/null | grep -q "ubuntu:24.04.*installed"; then
        echo "ubuntu:24.04"
    else
        echo "ubuntu"
    fi
}

# 1-Tap Launcher Functions
ubuntu() {
    bash ~/launch_ubuntu.sh "$@"
}
alias u="ubuntu"

ubuntu-cli() {
    local c
    c=$(_get_ubroid_container)
    proot-distro login "$c" --bind /sdcard:/sdcard "$@"
}
alias uc="ubuntu-cli"

# Antigravity CLI (AGY) Turbo Mode from Termux
agy() {
    local c
    c=$(_get_ubroid_container)
    proot-distro login "$c" --bind /sdcard:/sdcard -- agy "$@"
}

alias wifi-scan="termux-wifi-scaninfo"
alias wifi-info="termux-wifi-connectioninfo"

